# Copy this file to secrets.toml (same folder) and fill in what you use.
# secrets.toml is gitignored — do not commit it. On Streamlit Cloud, paste the same
# contents into the app's Settings → Secrets box instead. Full walkthrough: docs/DEPLOY.md
#
#   copy secrets.toml.example secrets.toml

# Headlines + media mood (optional)
ALPHA_VANTAGE_API_KEY = "paste_your_key_here"

# ── Everything below is only for the cloud / multi-user setup ───────────────
# Leave it out to keep running as a single local user (data in portfolio_data/).

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN = "123456789:AA..."

# Supabase project (Project Settings → API): URL and the service_role key.
# The service key is powerful — it lives only here, never in the code or in a browser.
SUPABASE_URL = "https://xxxxxxxx.supabase.co"
SUPABASE_SERVICE_KEY = "eyJ..."

# SEC fair-access rule: your name + contact email on every SEC request (insider scan)
SEC_USER_AGENT = "Your Name you@example.com"

# Who can manage the invite list (you)
ADMIN_EMAILS = ["you@gmail.com"]

# Sign-in (Auth0: Applications → your app → Settings). Keep [auth] LAST in the file.
[auth]
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"   # locally: http://localhost:8501/oauth2callback
cookie_secret = "a-long-random-string"   # python -c "import secrets; print(secrets.token_hex(32))"  — never share it
client_id = "your-auth0-client-id"
client_secret = "your-auth0-client-secret"
server_metadata_url = "https://YOUR-DOMAIN.us.auth0.com/.well-known/openid-configuration"
client_kwargs = { prompt = "login" }   # always show the sign-in screen (no silent reuse of a wrong account)
